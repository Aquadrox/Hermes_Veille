# voici les secrets attendus par le conteneur.
# Copier en `.env` et remplir. NE JAMAIS committer le `.env` rempli.

# ── Modèle (agent de génération) ────────────────────────────────────────────
DEEPSEEK_API_KEY=
# Réglés dans config.yaml au premier démarrage uniquement
# VEILLE_MODEL=deepseek-v4-pro
# VEILLE_PROVIDER=deepseek

# ── Envoi d'e-mail (API transactionnelle Brevo) ─────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# ── Veilles ─────────────────────────────────────────────────────────────────
# Destinataires de la veille par défaut, créée au PREMIER démarrage d'une
# installation neuve (séparés par des virgules). Vide : créée en pause.
VEILLE_RECIPIENTS=
# Adresse d'administration : alertes du chien de garde (hôte).
ALERT_EMAIL=

# ── Veille composants : statut de cycle de vie Digi-Key (facultatif) ───────
# Application « Production » sur https://developer.digikey.com, API Product Information v4,
# OAuth 2-legged (client credentials). Vide : seule la recherche web est utilisée.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# ── Interface web (tunnel SSH uniquement) ───────────────────────────────────
# Générer les deux valeurs avec : make ui-password
# Sans elles, l'interface reste désactivée.
VEILLE_UI_PASSWORD_HASH=
VEILLE_UI_SECRET=
# VEILLE_UI_ENABLED=true
# VEILLE_UI_PORT=8088

# ── Données persistantes ────────────────────────────────────────────────────
# Dossier de l'hôte monté sur /opt/data : veilles, rapports, jobs, historique, coûts.
# RECOMMANDÉ hors du dépôt git, pour qu'aucune mise à jour (re-clone, git clean) ne
# puisse le toucher. Vide : ./data du dépôt (défaut historique).
# Installation existante : make move-data DEST=/srv/veille-hermes/data
# Première installation  : ./scripts/deploy.sh --init
VEILLE_DATA_DIR=/srv/veille-hermes/data

# ── Fuseau et identité du conteneur ─────────────────────────────────────────
TZ=Europe/Paris
# UID/GID de l'hôte propriétaire du dossier de données (évite les « Permission denied »)
HERMES_UID=10000
HERMES_GID=10000

# ── Optionnel : gateway Telegram ────────────────────────────────────────────
# ⚠️ Un token de bot ne peut être utilisé que par UN SEUL gateway à la fois.
# À renseigner uniquement si le conteneur remplace le gateway de l'hôte.
# TELEGRAM_BOT_TOKEN=

# ── Optionnel : API server OpenAI-compatible (désactivé par défaut) ─────────
# API_SERVER_ENABLED=true
# API_SERVER_HOST=0.0.0.0
# API_SERVER_KEY=        # openssl rand -hex 32
