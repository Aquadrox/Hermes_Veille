[Unit]
Description=Chien de garde de la veille technologique (contrôle de production)
Documentation=https://github.com/Aquadrox/Hermes_Veille
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /root/veille-hermes/scripts/watchdog.py
# Le code de sortie 1 signifie « problème détecté » : la sonde a parfaitement
# fonctionné et a alerté par e-mail. Ce n'est donc PAS un échec du service
# (sinon systemd le marquerait « failed » et polluerait le journal).
SuccessExitStatus=0 1
User=root
