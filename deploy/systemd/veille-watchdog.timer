[Unit]
Description=Contrôle quotidien des veilles

[Timer]
# Tous les jours à 10h (heure de Paris). Chaque veille a son propre seuil de
# fraîcheur (plus grand écart entre deux tirs + 24 h) : un rapport manquant est
# signalé au plus tard le lendemain de l'échéance.
OnCalendar=*-*-* 10:00:00
# Si la machine était éteinte à l'heure prévue, le contrôle est rattrapé au boot.
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
