#!/bin/sh
# veille-mcp — serveur MCP (stdio) des veilles, lancé par Hermes.
#   depuis l'hôte : docker exec -i -u hermes veille-hermes veille-mcp
export HERMES_HOME="${HERMES_HOME:-/opt/data}"
export PYTHONPATH="/opt/veille-app${PYTHONPATH:+:$PYTHONPATH}"
exec /opt/veille-app/.venv/bin/python -m veille_mcp "$@"
