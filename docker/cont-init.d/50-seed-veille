#!/command/with-contenv sh
# shellcheck shell=sh
#
# 50-seed-veille — amorçage et réconciliation des veilles, À CHAQUE démarrage.
#
# S'exécute après les hooks de l'image officielle (01-hermes-setup,
# 02-reconcile-profiles). Toutes les étapes sont idempotentes et non destructives :
#   1. crée /opt/data/veilles (propriété hermes)
#   2. règle modèle et fuseau dans config.yaml (premier démarrage uniquement)
#   3. migre l'ancienne disposition mono-veille (/opt/data/veille) si présente
#   4. crée la veille par défaut sur une installation neuve (une seule fois)
#   5. réconcilie chaque veille avec son job cron (prompt re-rendu, job recréé
#      s'il a disparu) — c'est ce qui propage une mise à jour de l'image.
#   6. oublie les lancements manuels du démarrage précédent (`runs/.running`) :
#      leurs processus n'existent plus, et leur PID pourrait être réattribué.
#
# IMPORTANT : tout est exécuté EN TANT QUE hermes (sinon les fichiers créés
# appartiennent à root et les écritures suivantes échouent en permission).

export HERMES_HOME="${HERMES_HOME:-/opt/data}"
VEILLES_DIR="$HERMES_HOME/veilles"
HERMES_BIN="/opt/hermes/.venv/bin/hermes"
VEILLECTL="/usr/local/bin/veillectl"
CONFIG_MARKER="$VEILLES_DIR/.configured"
LEGACY_MARKER="$HERMES_HOME/veille/.seeded"

log() { echo "[seed-veille] $*"; }

# Même schéma que le hook officiel : on ne « drop » que si on est root.
# /command/ n'est pas toujours dans le PATH (docker exec), d'où la résolution.
S6_SETUIDGID="$(command -v s6-setuidgid 2>/dev/null || echo /command/s6-setuidgid)"
as_hermes() {
    [ "$(id -u)" = 0 ] || { "$@"; return; }
    "$S6_SETUIDGID" hermes "$@"
}

# --- 1. Répertoires des veilles et des imports de nomenclature ---
for dir in "$VEILLES_DIR" "$HERMES_HOME/imports"; do
    as_hermes mkdir -p "$dir" \
        || { mkdir -p "$dir" && chown hermes:hermes "$dir" 2>/dev/null; } \
        || log "ERREUR : impossible de créer $dir"
done

# --- 2. Modèle + fuseau horaire (premier démarrage) ---
# Le scheduler cron lit la timezone de la config Hermes (pas seulement $TZ).
if [ ! -f "$CONFIG_MARKER" ] && [ ! -f "$LEGACY_MARKER" ] && [ -x "$HERMES_BIN" ]; then
    set_config() {
        if as_hermes "$HERMES_BIN" config set "$1" "$2" >/dev/null 2>&1; then
            log "$1 = $2"
        else
            log "avertissement : $1 non réglé"
        fi
    }
    set_config model.default "${VEILLE_MODEL:-deepseek-v4-pro}"
    set_config model.provider "${VEILLE_PROVIDER:-deepseek}"
    set_config timezone "${TZ:-Europe/Paris}"
fi
as_hermes touch "$CONFIG_MARKER" 2>/dev/null || true

if [ ! -x "$VEILLECTL" ] || [ ! -x "$HERMES_BIN" ]; then
    log "ERREUR : veillectl ou hermes introuvable — veilles non réconciliées"
    exit 0
fi

# --- 3. Migration de l'ancienne disposition ---
as_hermes "$VEILLECTL" migrate 2>&1 | sed 's/^/[seed-veille] migrate: /'

# --- 4. Veille par défaut (installation neuve uniquement) ---
as_hermes "$VEILLECTL" bootstrap 2>&1 | sed 's/^/[seed-veille] bootstrap: /'

# --- 5. Réconciliation ---
as_hermes "$VEILLECTL" reconcile 2>&1 | sed 's/^/[seed-veille] reconcile: /'

# --- 6. Lancements manuels interrompus par le redémarrage ---
find "$VEILLES_DIR" -mindepth 3 -maxdepth 3 -path '*/runs/.running' -type f -delete 2>/dev/null || true

log "veilles :"
as_hermes "$VEILLECTL" list 2>&1 | sed 's/^/  /'
log "amorçage terminé"
